# Root ignore — protect secrets and local tooling across the monorepo.

# Environment / secrets
.env
.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Coverage / build artifacts
coverage/
dist/
*.zip
*-fixed/
