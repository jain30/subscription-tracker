# =============================================================================
# PUBLIC client configuration only (safe to ship in the Expo app bundle)
# =============================================================================
# Copy to mobile/.env and fill in values from the Supabase dashboard:
# Project Settings → API (URL) and API Keys (Publishable / anon key).
#
# NEVER put any of the following in this app or in EXPO_PUBLIC_* variables:
# - SUPABASE_SERVICE_ROLE_KEY / service_role
# - database password
# - Postgres connection string with credentials
# - any privileged admin secret
# =============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy Express scaffold base URL (unused by Phase 17 Supabase auth/CRUD)
EXPO_PUBLIC_API_URL=http://localhost:5000

# =============================================================================
# Manual Supabase Dashboard configuration (not env vars)
# =============================================================================
# Authentication → URL Configuration → Redirect URLs — add:
#   subscriptiontracker://reset-password
#   subscriptiontracker://**
# While using Expo Go, also add the current exp://…/--/reset-password URL
# from Linking.createURL('reset-password') on your device/simulator.
#
# Prefer regenerating Database types after linking a project (repo root):
#   npx supabase gen types typescript --linked --schema public > supabase/types/database.ts
# mobile/types/database.ts re-exports that file (do not duplicate).
# =============================================================================
